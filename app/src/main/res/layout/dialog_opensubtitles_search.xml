<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tv_dialog_shell"
    android:elevation="24dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/os_search_title"
            android:textColor="@color/tv_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/osMovie"
            style="@style/Mpv.SurfaceButton.Compact"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_tv_track_row"
            android:minHeight="40dp"
            android:minWidth="80dp"
            android:nextFocusDown="@id/osTitle"
            android:nextFocusRight="@id/osEpisodeMode"
            android:text="@string/os_search_movie" />

        <Button
            android:id="@+id/osEpisodeMode"
            style="@style/Mpv.SurfaceButton.Compact"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tv_track_row"
            android:minHeight="40dp"
            android:minWidth="88dp"
            android:nextFocusDown="@id/osTitle"
            android:nextFocusLeft="@id/osMovie"
            android:text="@string/os_search_episode" />
    </LinearLayout>

    <app.mpvnova.player.MaxHeightScrollView
        android:id="@+id/osFormViewport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fillViewport="false"
        android:focusable="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/osTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_tv_track_row"
                android:hint="@string/os_search_title_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="512"
                android:nextFocusDown="@id/osSeason"
                android:nextFocusForward="@id/osSeason"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/tv_text"
                android:textColorHint="@color/tv_text_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/osSeason"
                    android:layout_width="112dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_tv_track_row"
                    android:contentDescription="@string/os_search_season"
                    android:hint="@string/os_search_season"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:nextFocusUp="@id/osTitle"
                    android:nextFocusRight="@id/osEpisode"
                    android:nextFocusDown="@id/osResults"
                    android:nextFocusForward="@id/osEpisode"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/tv_text"
                    android:textColorHint="@color/tv_text_dim"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/osEpisode"
                    android:layout_width="112dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_tv_track_row"
                    android:contentDescription="@string/os_search_episode"
                    android:hint="@string/os_search_episode"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:nextFocusUp="@id/osTitle"
                    android:nextFocusLeft="@id/osSeason"
                    android:nextFocusRight="@id/osLanguage"
                    android:nextFocusDown="@id/osResults"
                    android:nextFocusForward="@id/osLanguage"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/tv_text"
                    android:textColorHint="@color/tv_text_dim"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/osLanguage"
                    style="@style/Mpv.SurfaceButton.Compact"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_tv_track_row"
                    android:contentDescription="@string/os_search_language"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusUp="@id/osTitle"
                    android:nextFocusLeft="@id/osEpisode"
                    android:nextFocusRight="@id/osSearch"
                    android:nextFocusDown="@id/osResults"
                    android:nextFocusForward="@id/osSearch"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical|start"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/osSearch"
                    style="@style/Mpv.SurfaceButton.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:minWidth="96dp"
                    android:nextFocusUp="@id/osTitle"
                    android:nextFocusLeft="@id/osLanguage"
                    android:nextFocusDown="@id/osResults"
                    android:nextFocusForward="@id/osResults"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/os_search_search" />
            </LinearLayout>
        </LinearLayout>
    </app.mpvnova.player.MaxHeightScrollView>

    <FrameLayout
        android:id="@+id/osResultsViewport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipChildren="true"
        android:visibility="gone">

        <ListView
            android:id="@+id/osResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="20dp"
            android:clipToPadding="true"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:listSelector="@android:color/transparent"
            android:nextFocusUp="@id/osSearch"
            android:nextFocusDown="@id/osMore"
            android:nextFocusForward="@id/osMore"
            android:overScrollMode="never"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:scrollbars="none" />

        <View
            android:id="@+id/osResultsScrollbarThumb"
            android:layout_width="3dp"
            android:layout_height="48dp"
            android:layout_gravity="end|top"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_tv_scrollbar_thumb"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/osProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:focusable="false"
            android:indeterminate="true"
            android:indeterminateTint="@color/tv_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/osStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/tv_text_dim"
            android:textSize="12sp" />

        <Button
            android:id="@+id/osMore"
            style="@style/Mpv.SurfaceButton.Compact"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minHeight="44dp"
            android:minWidth="96dp"
            android:nextFocusUp="@id/osResults"
            android:nextFocusRight="@id/osClose"
            android:nextFocusForward="@id/osClose"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/os_search_more" />

        <Button
            android:id="@+id/osClose"
            style="@style/Mpv.SurfaceButton.Compact"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:minHeight="44dp"
            android:minWidth="96dp"
            android:nextFocusUp="@id/osResults"
            android:nextFocusLeft="@id/osMore"
            android:nextFocusForward="@id/osTitle"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/os_search_close" />
    </LinearLayout>
</LinearLayout>
