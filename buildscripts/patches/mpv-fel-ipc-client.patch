+static void fel_wakeup(void *opaque)
+{
+    mp_filter_wakeup(opaque);
+}
+
+static void fel_stop(vd_ffmpeg_ctx *ctx)
+{
+    if (ctx->fel_client && ctx->fel_close)
+        ctx->fel_close(&ctx->fel_client);
+}
+
+static bool fel_start(struct mp_filter *vd)
+{
+    vd_ffmpeg_ctx *ctx = vd->priv;
+    if (!ctx->force_fel_ipc || !ctx->fel_helper_path)
+        return false;
+    if (!ctx->fel_library) {
+        const char *library = getenv("MPV_FEL_CLIENT_LIB");
+        ctx->fel_library = dlopen(library && library[0] ? library :
+                                  "libfelreceiver.so", RTLD_NOW | RTLD_LOCAL);
+        if (!ctx->fel_library) {
+            MP_ERR(vd, "FEL IPC client load failed: %s\n", dlerror());
+            return false;
+        }
+#define FEL_SYMBOL(field, symbol) \
+        *(void **)(&ctx->field) = dlsym(ctx->fel_library, symbol)
+        FEL_SYMBOL(fel_open, "fel_ipc_open");
+        FEL_SYMBOL(fel_submit, "fel_ipc_submit");
+        FEL_SYMBOL(fel_finish, "fel_ipc_finish");
+        FEL_SYMBOL(fel_receive, "fel_ipc_receive");
+        FEL_SYMBOL(fel_close, "fel_ipc_close");
+#undef FEL_SYMBOL
+        if (!ctx->fel_open || !ctx->fel_submit || !ctx->fel_finish ||
+            !ctx->fel_receive || !ctx->fel_close) {
+            MP_ERR(vd, "FEL IPC client is missing a required symbol.\n");
+            dlclose(ctx->fel_library);
+            ctx->fel_library = NULL;
+            return false;
+        }
+    }
+    ctx->fel_client = ctx->fel_open(ctx->fel_helper_path, fel_wakeup, vd);
+    if (!ctx->fel_client) {
+        MP_ERR(vd, "FEL IPC helper startup failed.\n");
+        return false;
+    }
+    MP_INFO(vd, "FEL IPC enhancement decoder active.\n");
+    return true;
+}
