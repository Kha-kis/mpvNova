+            rc = ctx->fel_submit(ctx->fel_client, pkt->buffer, pkt->len,
+                                 pts, dts, pkt->keyframe ? 1 : 0);
+        }
+        return rc == 0 ? 0 : rc == 1 ? AVERROR(EAGAIN) : AVERROR_EXTERNAL;
+    }
 
