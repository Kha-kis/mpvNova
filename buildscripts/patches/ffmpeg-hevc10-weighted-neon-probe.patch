diff --git a/libavcodec/arm/hevc10_luma_weak_neon.c b/libavcodec/arm/hevc10_luma_weak_neon.c
new file mode 100644
index 0000000..bf6aeaf
--- /dev/null
+++ b/libavcodec/arm/hevc10_luma_weak_neon.c
@@ -0,0 +1,112 @@
+/* Experimental 10-bit HEVC horizontal luma deblock for ARM NEON.
+ * The edge decision and strong filter match the scalar reference; the
+ * four-pixel weak filter is vectorized. Licensed under LGPL-2.1-or-later. */
+
+#include <arm_neon.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+static inline int clip_int(int x, int lo, int hi)
+{
+    return x < lo ? lo : x > hi ? hi : x;
+}
+
+static inline uint16x4_t clip10(int16x4_t x)
+{
+    return vreinterpret_u16_s16(vmax_s16(vmin_s16(x, vdup_n_s16(1023)),
+                                          vdup_n_s16(0)));
+}
+
+static void weak4(uint16_t *p, ptrdiff_t stride, int tc,
+                  int no_p, int no_q, int nd_p, int nd_q)
+{
+    const int16x4_t p2 = vreinterpret_s16_u16(vld1_u16(p - 3 * stride));
+    const int16x4_t p1 = vreinterpret_s16_u16(vld1_u16(p - 2 * stride));
+    const int16x4_t p0 = vreinterpret_s16_u16(vld1_u16(p - stride));
+    const int16x4_t q0 = vreinterpret_s16_u16(vld1_u16(p));
+    const int16x4_t q1 = vreinterpret_s16_u16(vld1_u16(p + stride));
+    const int16x4_t q2 = vreinterpret_s16_u16(vld1_u16(p + 2 * stride));
+    int16x4_t delta = vsub_s16(q0, p0);
+    delta = vsub_s16(vmul_n_s16(delta, 9),
+                    vmul_n_s16(vsub_s16(q1, p1), 3));
+    delta = vshr_n_s16(vadd_s16(delta, vdup_n_s16(8)), 4);
+    const uint16x4_t mask = vclt_s16(vabs_s16(delta), vdup_n_s16(10 * tc));
+    delta = vmax_s16(vmin_s16(delta, vdup_n_s16(tc)), vdup_n_s16(-tc));
+    if (!no_p) {
+        const uint16x4_t out = clip10(vadd_s16(p0, delta));
+        vst1_u16(p - stride, vbsl_u16(mask, out, vreinterpret_u16_s16(p0)));
+        if (nd_p > 1) {
+            int16x4_t d = vshr_n_s16(vadd_s16(vadd_s16(p2, p0), vdup_n_s16(1)), 1);
+            d = vshr_n_s16(vadd_s16(vsub_s16(d, p1), delta), 1);
+            d = vmax_s16(vmin_s16(d, vdup_n_s16(tc >> 1)), vdup_n_s16(-(tc >> 1)));
+            vst1_u16(p - 2 * stride,
+                     vbsl_u16(mask, clip10(vadd_s16(p1, d)), vreinterpret_u16_s16(p1)));
+        }
+    }
+    if (!no_q) {
+        const uint16x4_t out = clip10(vsub_s16(q0, delta));
+        vst1_u16(p, vbsl_u16(mask, out, vreinterpret_u16_s16(q0)));
+        if (nd_q > 1) {
+            int16x4_t d = vshr_n_s16(vadd_s16(vadd_s16(q2, q0), vdup_n_s16(1)), 1);
+            d = vshr_n_s16(vsub_s16(vsub_s16(d, q1), delta), 1);
+            d = vmax_s16(vmin_s16(d, vdup_n_s16(tc >> 1)), vdup_n_s16(-(tc >> 1)));
+            vst1_u16(p + stride,
+                     vbsl_u16(mask, clip10(vadd_s16(q1, d)), vreinterpret_u16_s16(q1)));
+        }
+    }
+}
+
+static void strong4(uint16_t *p, ptrdiff_t stride, int tc, int no_p, int no_q)
+{
+    for (int d = 0; d < 4; d++) {
+        const int p3 = p[-4 * stride], p2 = p[-3 * stride];
+        const int p1 = p[-2 * stride], p0 = p[-stride];
+        const int q0 = p[0], q1 = p[stride];
+        const int q2 = p[2 * stride], q3 = p[3 * stride];
+        if (!no_p) {
+            p[-stride] = p0 + clip_int(((p2 + 2*p1 + 2*p0 + 2*q0 + q1 + 4) >> 3) - p0, -tc, tc);
+            p[-2*stride] = p1 + clip_int(((p2 + p1 + p0 + q0 + 2) >> 2) - p1, -tc, tc);
+            p[-3*stride] = p2 + clip_int(((2*p3 + 3*p2 + p1 + p0 + q0 + 4) >> 3) - p2, -tc, tc);
+        }
+        if (!no_q) {
+            p[0] = q0 + clip_int(((p1 + 2*p0 + 2*q0 + 2*q1 + q2 + 4) >> 3) - q0, -tc, tc);
+            p[stride] = q1 + clip_int(((p0 + q0 + q1 + q2 + 2) >> 2) - q1, -tc, tc);
+            p[2*stride] = q2 + clip_int(((2*q3 + 3*q2 + q1 + q0 + p0 + 4) >> 3) - q2, -tc, tc);
+        }
+        p++;
+    }
+}
+
+void ff_hevc_h_loop_filter_luma_10_neon(uint8_t *_pix, ptrdiff_t _stride,
+                                         int beta, const int *tc_in,
+                                         const uint8_t *no_p, const uint8_t *no_q)
+{
+    const ptrdiff_t stride = _stride / 2;
+    uint16_t *pix = (uint16_t *)_pix;
+    beta <<= 2;
+    for (int j = 0; j < 2; j++) {
+        uint16_t *p = pix + 4 * j;
+        const int dp0 = abs((int)p[-3*stride] - 2*(int)p[-2*stride] + p[-stride]);
+        const int dq0 = abs((int)p[2*stride] - 2*(int)p[stride] + p[0]);
+        const int dp3 = abs((int)p[-3*stride+3] - 2*(int)p[-2*stride+3] + p[-stride+3]);
+        const int dq3 = abs((int)p[2*stride+3] - 2*(int)p[stride+3] + p[3]);
+        const int d0 = dp0 + dq0, d3 = dp3 + dq3;
+        const int tc = tc_in[j] << 2;
+        if (d0 + d3 >= beta)
+            continue;
+        const int beta3 = beta >> 3, beta2 = beta >> 2;
+        const int tc25 = (tc * 5 + 1) >> 1;
+        if (abs((int)p[-4*stride] - p[-stride]) + abs((int)p[3*stride] - p[0]) < beta3 &&
+            abs((int)p[-stride] - p[0]) < tc25 &&
+            abs((int)p[-4*stride+3] - p[-stride+3]) + abs((int)p[3*stride+3] - p[3]) < beta3 &&
+            abs((int)p[-stride+3] - p[3]) < tc25 &&
+            (d0 << 1) < beta2 && (d3 << 1) < beta2) {
+            strong4(p, stride, tc << 1, no_p[j], no_q[j]);
+        } else {
+            const int threshold = (beta + (beta >> 1)) >> 3;
+            weak4(p, stride, tc, no_p[j], no_q[j],
+                  1 + (dp0 + dp3 < threshold), 1 + (dq0 + dq3 < threshold));
+        }
+    }
+}
